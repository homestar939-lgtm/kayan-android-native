<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        Permissions strategy:
        - We use Storage Access Framework (SAF) for file access.
        - READ_EXTERNAL_STORAGE / WRITE_EXTERNAL_STORAGE are NOT requested.
        - MANAGE_EXTERNAL_STORAGE is NOT requested — SAF is sufficient.
        - The user grants per-folder access via system file picker UI.
    -->

    <!-- Required for LlamaEngine native lib to init -->
    <uses-feature android:name="android.hardware.vulkan.level" android:required="false" />

    <application
        android:name=".KayanApplication"
        android:label="@string/app_name"
        android:icon="@android:mipmap/sym_def_app_icon"
        android:roundIcon="@android:mipmap/sym_def_app_icon"
        android:supportsRtl="true"
        android:theme="@style/Theme.KayanX"
        android:allowBackup="false"
        android:largeHeap="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            FileProvider is declared to share internal files IF needed in future.
            GGUF model is NOT distributed via FileProvider — it is user-selected via SAF.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
